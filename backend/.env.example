# --- server ---
PORT=5000
ENV=development

# --- database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=naitri

# --- auth ---
# REQUIRED in production, and must be >= 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- cors / websocket origin allowlist (comma separated) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- webrtc ---
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# A TURN server is required for clients behind symmetric NAT or strict
# corporate firewalls. Without it those users will fail to connect.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Set to the server's public address when running behind 1:1 NAT (EC2, GCE,
# most cloud VMs). Without it the SFU only advertises its private IP.
PUBLIC_IP=

MAX_ROOM_SIZE=25
