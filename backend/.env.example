# --- server ---
PORT=5000
ENV=development

# --- database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=naitri

# --- auth ---
# REQUIRED in production, and must be >= 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- cors / websocket origin allowlist (comma separated) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- webrtc ---
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# A TURN server is required for clients behind symmetric NAT or strict
# corporate firewalls. Without it those users will fail to connect.
TURN_URL=
#
# Preferred: time-limited credentials. Set the same value as coturn's
# `static-auth-secret` (run coturn with `use-auth-secret`). Each user then gets
# their own credentials that expire after TURN_CREDENTIAL_TTL.
# REQUIRED in production whenever TURN_URL is set.
TURN_SECRET=
TURN_CREDENTIAL_TTL=6h
#
# Fallback for local testing only: static credentials are sent to every
# signed-in user and never expire. Ignored when TURN_SECRET is set.
TURN_USERNAME=
TURN_PASSWORD=

# Set to the server's public address when running behind 1:1 NAT (EC2, GCE,
# most cloud VMs). Without it the SFU only advertises its private IP.
PUBLIC_IP=

MAX_ROOM_SIZE=25
